{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oulipoly:session-control:v2",
  "title": "Oulipoly Session Control v2",
  "description": "Provider-neutral, bounded root control claims exchanged between a requester and the existing root owner: descriptive root discovery, current control-state inspection, input hold/release, same-incarnation recover, cancel and close requests on one claim ladder, and settlement observations about logical work. One vocabulary for session control and infrastructure control. Selected by peer advertisement of oulipoly.session_control/v2, not by provider describe, CLI, binary, package or source identity. It is not a provider/v1 subcommand or a second host/provider protocol. Records are claims: validating one does not establish that its producer told the truth, that a requester was authorized, that a control was enforced or durable, or that any actor is in custody. Contract refusals are control_unavailable diagnostics. Structural schema and the adjacent README normative semantic rules together define conformance; raw schema validation alone is insufficient.",
  "$defs": {
    "Protocol": { "const": "oulipoly.session_control/v2" },
    "HostRef": {
      "description": "Opaque host-owned value. The SDK compares it only for equality and is neither its authority nor its registry.",
      "type": "string",
      "pattern": "^[\\x21-\\x7e]{1,256}$"
    },
    "RequestKey": {
      "description": "Requester-chosen idempotency key, scoped to (requester, addressed root).",
      "type": "string",
      "pattern": "^[\\x21-\\x7e]{1,128}$"
    },
    "UnixMilliseconds": {
      "description": "A bounded host observation time. Not an ordering clock or causal evidence.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Authority": {
      "description": "The existing Runner root authority a control request is addressed to or a response or report comes from: root id, owner, owner generation and root incarnation. Opaque equality values; carrying them makes staleness detectable, it does not fence anything.",
      "type": "object",
      "properties": {
        "root": { "$ref": "#/$defs/HostRef" },
        "owner": { "$ref": "#/$defs/HostRef" },
        "generation": { "$ref": "#/$defs/HostRef" },
        "incarnation": { "$ref": "#/$defs/HostRef" }
      },
      "required": ["root", "owner", "generation", "incarnation"],
      "additionalProperties": false
    },
    "ControlScope": {
      "description": "The logical scope a control applies to: a root, optionally narrowed to one logical child. Never a provider session, process, Agent Bash handle or stream.",
      "type": "object",
      "properties": {
        "root": { "$ref": "#/$defs/HostRef" },
        "child": { "$ref": "#/$defs/HostRef" }
      },
      "required": ["root"],
      "additionalProperties": false
    },
    "LogicalRef": {
      "description": "A logical root/child/work/input link. Logical identity only; actor identities are attached separately as ActorEvidence.",
      "type": "object",
      "properties": {
        "root": { "$ref": "#/$defs/HostRef" },
        "child": { "$ref": "#/$defs/HostRef" },
        "work": { "$ref": "#/$defs/HostRef" },
        "input": { "$ref": "#/$defs/HostRef" }
      },
      "required": ["root"],
      "additionalProperties": false
    },
    "RequestRef": {
      "description": "The immutable identity of one control intent: its key scope and the authority it was addressed to.",
      "type": "object",
      "properties": {
        "request_key": { "$ref": "#/$defs/RequestKey" },
        "requester": { "$ref": "#/$defs/HostRef" },
        "addressed": { "$ref": "#/$defs/Authority" }
      },
      "required": ["request_key", "requester", "addressed"],
      "additionalProperties": false
    },
    "Operation": {
      "description": "input_hold/input_release hold or clear admission of new input; running work may continue. recover attaches a successor owner to the surviving recorded incarnation of the same root and never starts a new incarnation. cancel and close are distinct root lifecycle transitions; a close is not a cancel and neither is an input hold. Physical execution pause and drain are not operations.",
      "enum": ["input_hold", "input_release", "recover", "cancel", "close"]
    },
    "State": {
      "description": "Transition states. Input domain: input_held, input_open. Lifecycle domain: open, closing, cancelling. Attachment domain: attached, unattached. unknown belongs to every domain. input_held is not paused, drained or stopped execution; closing and cancelling are requested transitions, not ended work.",
      "enum": ["input_held", "input_open", "open", "closing", "cancelling", "attached", "unattached", "unknown"]
    },
    "Report": {
      "description": "Descriptive views: discovery (root_entry records) and inspection (control_state records). Neither is an effect or an authority.",
      "enum": ["discovery", "inspection"]
    },
    "MissingReason": {
      "description": "Why a value is absent. None of these is a negative observation.",
      "enum": ["not_captured", "access_denied", "unsupported", "not_applicable"]
    },
    "Text": { "type": "string", "minLength": 1, "maxLength": 512 },
    "DisclosedText": {
      "description": "Bounded free text, or an explicit redaction or missing marker. Redacted is distinguishable from missing. Bounds are not sanitization.",
      "oneOf": [
        {
          "type": "object",
          "properties": { "state": { "const": "present" }, "text": { "$ref": "#/$defs/Text" } },
          "required": ["state", "text"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "state": { "const": "redacted" } },
          "required": ["state"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": { "const": "missing" },
            "reason": { "$ref": "#/$defs/MissingReason" }
          },
          "required": ["state", "reason"],
          "additionalProperties": false
        }
      ]
    },
    "DisclosedRef": {
      "description": "An opaque host reference, or an explicit redaction or missing marker.",
      "oneOf": [
        {
          "type": "object",
          "properties": { "state": { "const": "present" }, "ref": { "$ref": "#/$defs/HostRef" } },
          "required": ["state", "ref"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "state": { "const": "redacted" } },
          "required": ["state"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": { "const": "missing" },
            "reason": { "$ref": "#/$defs/MissingReason" }
          },
          "required": ["state", "reason"],
          "additionalProperties": false
        }
      ]
    },
    "ActorEvidence": {
      "description": "Actor identity evidence attached to a logical link: an OS process identity, an Agent Bash handle, a provider-native session or a live stream. Exactness is the producer's claim. Correlation is reported, not defined, by the SDK.",
      "type": "object",
      "properties": {
        "actor": { "enum": ["os_process", "bash_handle", "provider_session", "live_stream"] },
        "exactness": { "enum": ["exact", "legacy", "incomplete"] },
        "ref": { "$ref": "#/$defs/DisclosedRef" }
      },
      "required": ["actor", "exactness", "ref"],
      "additionalProperties": false
    },
    "Correlation": {
      "description": "Fields every control response repeats from the request it answers.",
      "type": "object",
      "properties": {
        "protocol": { "$ref": "#/$defs/Protocol" },
        "request_key": { "$ref": "#/$defs/RequestKey" },
        "requester": { "$ref": "#/$defs/HostRef" },
        "addressed": { "$ref": "#/$defs/Authority" }
      },
      "required": ["protocol", "request_key", "requester", "addressed"]
    },
    "Request": {
      "description": "Requester intent. Not receipt, admission, acknowledgment or outcome. Its RequestRef stays addressable for later knowledge.",
      "type": "object",
      "properties": {
        "kind": { "const": "request" },
        "protocol": { "$ref": "#/$defs/Protocol" },
        "request_key": { "$ref": "#/$defs/RequestKey" },
        "requester": { "$ref": "#/$defs/HostRef" },
        "addressed": { "$ref": "#/$defs/Authority" },
        "operation": { "$ref": "#/$defs/Operation" },
        "scope": { "$ref": "#/$defs/ControlScope" },
        "reason": { "$ref": "#/$defs/DisclosedText" }
      },
      "required": ["kind", "protocol", "request_key", "requester", "addressed", "operation", "scope"],
      "additionalProperties": false
    },
    "Receipt": {
      "description": "Transport receipt: the request reached a queue or endpoint. durable states whether the receiver claims durable retention of the request. Never admission, acknowledgment or outcome.",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/Correlation" }],
      "properties": {
        "kind": { "const": "receipt" },
        "protocol": true,
        "request_key": true,
        "requester": true,
        "addressed": true,
        "durable": { "type": "boolean" },
        "observed_at_unix_ms": { "$ref": "#/$defs/UnixMilliseconds" }
      },
      "required": ["kind", "durable", "observed_at_unix_ms"],
      "additionalProperties": false
    },
    "Admission": {
      "description": "The answering authority admitted the request for its transition. Not the transition itself.",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/Correlation" }],
      "properties": {
        "kind": { "const": "admission" },
        "protocol": true,
        "request_key": true,
        "requester": true,
        "addressed": true,
        "operation": { "$ref": "#/$defs/Operation" },
        "responder": { "$ref": "#/$defs/Authority" },
        "observed_at_unix_ms": { "$ref": "#/$defs/UnixMilliseconds" }
      },
      "required": ["kind", "operation", "responder", "observed_at_unix_ms"],
      "additionalProperties": false
    },
    "Acknowledgment": {
      "description": "Semantic transition acknowledgment from the answering authority: the operation's state moved from `from` to `to`. It says nothing about running work, ended work or physical custody.",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/Correlation" }],
      "properties": {
        "kind": { "const": "acknowledgment" },
        "protocol": true,
        "request_key": true,
        "requester": true,
        "addressed": true,
        "responder": { "$ref": "#/$defs/Authority" },
        "operation": { "$ref": "#/$defs/Operation" },
        "from": { "$ref": "#/$defs/State" },
        "to": { "$ref": "#/$defs/State" },
        "observed_at_unix_ms": { "$ref": "#/$defs/UnixMilliseconds" }
      },
      "required": ["kind", "responder", "operation", "from", "to", "observed_at_unix_ms"],
      "additionalProperties": false
    },
    "RefusalReason": {
      "description": "Admission-stage: stale_authority, owner_live, key_conflict, unsupported_operation, not_permitted, unknown_scope. Transition-stage: already_terminal, root_absent, transition_failed.",
      "enum": [
        "stale_authority",
        "owner_live",
        "key_conflict",
        "unsupported_operation",
        "not_permitted",
        "unknown_scope",
        "already_terminal",
        "root_absent",
        "transition_failed"
      ]
    },
    "Fulfillment": {
      "description": "Same-incarnation successor reports its own present fulfillment of an inherited admitted intent; never a predecessor ACK or a new intent.",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/Correlation"
        }
      ],
      "properties": {
        "kind": {
          "const": "fulfillment"
        },
        "protocol": true,
        "request_key": true,
        "requester": true,
        "addressed": true,
        "operation": {
          "$ref": "#/$defs/Operation"
        },
        "from": {
          "$ref": "#/$defs/State"
        },
        "to": {
          "$ref": "#/$defs/State"
        },
        "observed_at_unix_ms": {
          "$ref": "#/$defs/UnixMilliseconds"
        },
        "reporter": {
          "$ref": "#/$defs/Authority"
        }
      },
      "required": [
        "kind",
        "reporter",
        "operation",
        "from",
        "to",
        "observed_at_unix_ms"
      ],
      "additionalProperties": false
    },
    "Refusal": {
      "description": "An explicit refusal, at admission or at transition. A refusal is an outcome, not an absent acknowledgment.",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/Correlation" }],
      "properties": {
        "kind": { "const": "refusal" },
        "protocol": true,
        "request_key": true,
        "requester": true,
        "addressed": true,
        "operation": { "$ref": "#/$defs/Operation" },
        "stage": { "enum": ["admission", "transition"] },
        "reason": { "$ref": "#/$defs/RefusalReason" },
        "responder": { "$ref": "#/$defs/Authority" },
        "detail": { "$ref": "#/$defs/DisclosedText" },
        "observed_at_unix_ms": { "$ref": "#/$defs/UnixMilliseconds" }
      },
      "required": ["kind", "operation", "stage", "reason", "observed_at_unix_ms"],
      "additionalProperties": false
    },
    "Outcome": {
      "description": "Later knowledge of the same immutable intent: acknowledged, fulfilled or refused are final; unknown is refinable and preserves earlier claims.",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/Correlation" }],
      "properties": {
        "kind": { "const": "outcome" },
        "protocol": true,
        "request_key": true,
        "requester": true,
        "addressed": true,
        "result": { "enum": ["acknowledged", "fulfilled", "refused", "unknown"] },
        "uncertainty": { "enum": ["authority_changed", "transport_lost", "evidence_unavailable"] },
        "reporter": { "$ref": "#/$defs/Authority" },
        "observed_at_unix_ms": { "$ref": "#/$defs/UnixMilliseconds" }
      },
      "required": ["kind", "result", "observed_at_unix_ms"],
      "additionalProperties": false,
      "if": { "properties": { "result": { "const": "unknown" } } },
      "then": { "required": ["uncertainty"] },
      "else": { "not": { "required": ["uncertainty"] } }
    },
    "FactType": { "enum": ["insertion", "tagged_end", "logical_settlement", "physical_custody"] },
    "Fact": {
      "description": "One settlement fact. The four types are distinct claims: insertion acknowledgment, tagged turn end, logical settlement/debt and physical custody/waits. missing and redacted are never negatives.",
      "type": "object",
      "properties": {
        "type": { "$ref": "#/$defs/FactType" },
        "state": { "type": "string" },
        "missing_reason": { "$ref": "#/$defs/MissingReason" }
      },
      "required": ["type", "state"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "missing" } } },
          "then": { "required": ["missing_reason"] },
          "else": { "not": { "required": ["missing_reason"] } }
        },
        {
          "if": { "properties": { "type": { "const": "insertion" } } },
          "then": { "properties": { "state": { "enum": ["acknowledged", "not_inserted", "uncertain", "missing", "redacted"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "tagged_end" } } },
          "then": { "properties": { "state": { "enum": ["observed", "absent", "missing", "redacted"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "logical_settlement" } } },
          "then": { "properties": { "state": { "enum": ["settled", "owed", "missing", "redacted"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "physical_custody" } } },
          "then": { "properties": { "state": { "enum": ["live", "exited_wait_pending", "exited_waited", "unsettled", "missing", "redacted"] } } }
        }
      ]
    },
    "Observation": {
      "description": "A reported settlement fact about a logical link, with attached actor evidence. An observation is never a control, a request, an admission or an acknowledgment.",
      "type": "object",
      "properties": {
        "kind": { "const": "observation" },
        "protocol": { "$ref": "#/$defs/Protocol" },
        "reporter": { "$ref": "#/$defs/Authority" },
        "subject": { "$ref": "#/$defs/LogicalRef" },
        "fact": { "$ref": "#/$defs/Fact" },
        "evidence": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/ActorEvidence" }
        },
        "observed_at_unix_ms": { "$ref": "#/$defs/UnixMilliseconds" }
      },
      "required": ["kind", "protocol", "reporter", "subject", "fact", "observed_at_unix_ms"],
      "additionalProperties": false
    },
    "RootEntry": {
      "description": "Discovery: a descriptive address of one existing root for the requester, with its last known authority. The describer is an opaque locator, never an authority. An entry is not admission, scheduling, capacity, reservation or ownership, and does not prove its authority is current.",
      "type": "object",
      "properties": {
        "kind": { "const": "root_entry" },
        "protocol": { "$ref": "#/$defs/Protocol" },
        "describer": { "$ref": "#/$defs/HostRef" },
        "requester": { "$ref": "#/$defs/HostRef" },
        "authority": { "$ref": "#/$defs/Authority" },
        "observed_at_unix_ms": { "$ref": "#/$defs/UnixMilliseconds" }
      },
      "required": ["kind", "protocol", "describer", "requester", "authority", "observed_at_unix_ms"],
      "additionalProperties": false
    },
    "Current": {
      "description": "One current state as the reporter knows it, optionally with the request that established it.",
      "type": "object",
      "properties": {
        "state": { "$ref": "#/$defs/State" },
        "since": { "$ref": "#/$defs/RequestRef" }
      },
      "required": ["state"],
      "additionalProperties": false
    },
    "Pending": {
      "description": "A control intent the reporter holds that has no acknowledgment or refusal yet.",
      "type": "object",
      "properties": {
        "request": { "$ref": "#/$defs/RequestRef" },
        "operation": { "$ref": "#/$defs/Operation" },
        "status": { "enum": ["received", "admitted"] }
      },
      "required": ["request", "operation", "status"],
      "additionalProperties": false
    },
    "ControlState": {
      "description": "Inspection: the reporting authority's current knowledge of a scope's input hold and lifecycle state and its pending control intents. A report, not an effect or acknowledgment; current knowledge never erases an earlier acknowledgment.",
      "type": "object",
      "properties": {
        "kind": { "const": "control_state" },
        "protocol": { "$ref": "#/$defs/Protocol" },
        "reporter": { "$ref": "#/$defs/Authority" },
        "scope": { "$ref": "#/$defs/ControlScope" },
        "input": { "$ref": "#/$defs/Current" },
        "lifecycle": { "$ref": "#/$defs/Current" },
        "pending": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/Pending" }
        },
        "observed_at_unix_ms": { "$ref": "#/$defs/UnixMilliseconds" }
      },
      "required": ["kind", "protocol", "reporter", "scope", "input", "lifecycle", "observed_at_unix_ms"],
      "additionalProperties": false
    },
    "Record": {
      "description": "One control record.",
      "oneOf": [
        { "$ref": "#/$defs/Request" },
        { "$ref": "#/$defs/Receipt" },
        { "$ref": "#/$defs/Admission" },
        { "$ref": "#/$defs/Acknowledgment" },
        { "$ref": "#/$defs/Fulfillment" },
        { "$ref": "#/$defs/Refusal" },
        { "$ref": "#/$defs/Outcome" },
        { "$ref": "#/$defs/Observation" },
        { "$ref": "#/$defs/RootEntry" },
        { "$ref": "#/$defs/ControlState" }
      ]
    },
    "Offer": {
      "description": "One peer's oulipoly.session_control/v2 capability offer: the operations it can request or answer, the reports it can produce or read and the settlement facts it can report or read. input_hold is offered only together with input_release. At least one operation or report is offered.",
      "type": "object",
      "properties": {
        "operations": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Operation" }
        },
        "reports": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Report" }
        },
        "facts": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/FactType" }
        }
      },
      "required": ["operations", "reports", "facts"],
      "additionalProperties": false,
      "anyOf": [
        { "properties": { "operations": { "minItems": 1 } } },
        { "properties": { "reports": { "minItems": 1 } } }
      ],
      "if": { "properties": { "operations": { "contains": { "const": "input_hold" } } } },
      "then": { "properties": { "operations": { "contains": { "const": "input_release" } } } }
    },
    "Advertisement": {
      "description": "A peer's protocol offers. Unknown, older and newer entries are ignored; the v2 entry must be a strict Offer.",
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "pattern": "^[\\x21-\\x7e]{1,128}$" }
    },
    "ControlUnavailable": {
      "description": "Explicit control capability diagnostic. Not a provider error response, launch event, launch unavailability or completion outcome.",
      "type": "object",
      "properties": {
        "diagnostic": { "const": "control_unavailable" },
        "reason": {
          "enum": [
            "no_common_version",
            "invalid_advertisement",
            "no_common_capability",
            "invalid_record",
            "protocol_violation"
          ]
        },
        "detail": { "type": "string", "maxLength": 512 }
      },
      "required": ["diagnostic", "reason"],
      "additionalProperties": false
    }
  }
}
